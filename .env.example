# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

# === 外部大模型 API（必填）===
# 例：阿里云百炼（DashScope）OpenAI 兼容端点
#   OPENAI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 例：自建中转
#   OPENAI_API_BASE_URL=http://10.x.x.x:xxxx/v1
# 注意：末尾不要加 /
OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Bypass per-model access control so every connected model is usable by every
# user out of the box (skips the "Public/Private" filtering on /models, chat,
# embeddings, etc.). Set to "false" if you want to re-enable role-based gating.
BYPASS_MODEL_ACCESS_CONTROL=true

# Allow regular users to configure their own Direct Connections (custom
# OpenAI-compatible endpoints) under Settings -> Connections. Set to "false"
# to restrict this feature to admins only.
ENABLE_DIRECT_CONNECTIONS=true


# ============================================================================
#   以下为部署到服务器时新增/必填项（本地开发可以不填）
# ============================================================================

# === 必填：会话签名密钥 ===
# 用途：签发用户登录 session / JWT。一旦设定不要再改，否则所有用户被强制重新登录。
# 生成方式（任选其一）：
#   Linux/Mac:        openssl rand -hex 32
#   Windows PowerShell: [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
# 强烈建议在密码管理器里备份这一串。
WEBUI_SECRET_KEY=''

# === 可选：宿主机暴露端口（默认 3000）===
# 浏览器访问地址会变成 http://服务器IP:${OPEN_WEBUI_PORT}
OPEN_WEBUI_PORT=3000

# === 可选：业务数据宿主目录（默认 /data）===
# 该目录会以只读方式挂到容器内的 /pic_data，
# 供 generate_forecast_from_folder 等天气工具读取预报图。
# 宿主机典型结构：
#   /data/ecmwf/2026053112/h500w/*.png
#   /data/grapes/2026053112/r24/*.png
WEATHER_DATA_HOST_DIR=/data

# === 可选：容器内业务数据根（一般不用改）===
# 与 docker-compose.yaml 中的容器内挂载点保持一致即可。
WEATHER_DATA_ROOT=/pic_data

# === 可选：管理员首次注册自动设为管理员 ===
# open-webui 默认行为：第一个注册的账号自动成为 admin，无需配置。
# 若想关闭"开放注册"，进系统后到管理员面板 → 设置 → 通用 → 关闭"启用注册"。