# ===============================================================
# 风掣两个工具共用的环境变量（fengche-forecast / fengche-warning）。
# 复制为 .env.fengche 后按需修改；.env.fengche 不要提交到 git。
#
# 部署：
#   docker compose -f docker-compose.fengche.yml --env-file .env.fengche up -d --build
# ===============================================================

# ----------------------------- 数据源（生产用 FTP） ---------------------------
DATA_SOURCE=ftp

# 风掣 FTP 服务器
FTP_HOST=10.127.13.197
FTP_PORT=2123
FTP_USER=fengche
FTP_PASSWORD=填写实际密码
# fengche 账号登录后看到的根目录就是数据根，无需再指定子目录
FTP_BASE_DIR=/

# 路径模板（占位符 {Y} {Ym} {ymd} {HH}）；DATA_SOURCE=ftp 时默认就是下面这个，通常不用改：
# PATH_TEMPLATE={Y}/{Ym}/{ymd}/{ymd}T{HH}.nc

# ----------------------------- 通用 ---------------------------
DEFAULT_TIMEZONE=Asia/Shanghai
MAX_LOOKBACK_HOURS=24

# ----------------------------- forecast 服务（8765） ---------------------------
# 通常不动，端口由 compose 决定；这里仅为完整性
HOST=0.0.0.0

# ----------------------------- warning 服务（8766）阈值 ---------------------------
# 阵风（强对流）阈值（m/s），按风力等级 8/10/12 级
GS_YELLOW_MS=17.2
GS_ORANGE_MS=24.5
GS_RED_MS=32.7

# 暴雨阈值（mm，按国标 1h / 6h / 24h 三窗口 OR 触发）
# 蓝色：仅 6h ≥ 50
# 黄色：1h ≥ 50 或 6h ≥ 100 或 24h ≥ 150
# 橙色：1h ≥ 75 或 6h ≥ 150 或 24h ≥ 200
# 红色：1h ≥ 100 或 6h ≥ 200 或 24h ≥ 250
RAIN_1H_YELLOW=50
RAIN_1H_ORANGE=75
RAIN_1H_RED=100
RAIN_6H_BLUE=50
RAIN_6H_YELLOW=100
RAIN_6H_ORANGE=150
RAIN_6H_RED=200
RAIN_24H_YELLOW=150
RAIN_24H_ORANGE=200
RAIN_24H_RED=250
