# ===============================================================
# Fengche Forecast Tool Server - 环境变量样例
# 复制为 .env 后按需修改。.env 不要提交到 git。
# ===============================================================

# === 数据源切换：local（开发/调试）或 ftp（生产） ===
DATA_SOURCE=local

# === 本地路径模式 ===
# 仓库内开发时，默认指向 fengche/data_samples/（git 不入库的 NetCDF 样例）。
# 容器化部署里通常改成 /data/fengche，并通过 volumes 把宿主机目录挂进去。
LOCAL_BASE_DIR=./fengche/data_samples

# === FTP 模式（仅当 DATA_SOURCE=ftp 时使用） ===
FTP_HOST=10.127.13.197
FTP_PORT=2123
FTP_USER=fengche
FTP_PASSWORD=
# fengche 账号登录后所看到的根目录就是数据根，无需再指定子目录
FTP_BASE_DIR=/

# === 通用 ===
DEFAULT_TIMEZONE=Asia/Shanghai
MAX_LOOKBACK_HOURS=24

# === 路径模板（占位符 {Y} {Ym} {ymd} {HH}） ===
# 默认值会根据 DATA_SOURCE 自动选择：
#   local 模式默认: {ymd}/{ymd}T{HH}.nc           例 20260509/20260509T08.nc
#   ftp   模式默认: {Y}/{Ym}/{ymd}/{ymd}T{HH}.nc  例 2026/202605/20260509/20260509T08.nc
# 只有当目录布局不同时才需要在这里覆盖。
# PATH_TEMPLATE={Y}/{Ym}/{ymd}/{ymd}T{HH}.nc

# === 服务监听 ===
HOST=0.0.0.0
PORT=8765
