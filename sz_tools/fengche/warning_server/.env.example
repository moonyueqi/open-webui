# ===============================================================
# Fengche Warning Tool Server - 环境变量样例
# 复制为 .env 后按需修改。.env 不要提交到 git。
# ===============================================================

# === 数据源切换（与 fengche_tool_server 一致） ===
DATA_SOURCE=local

# 本地路径（开发期默认指向 fengche/data_samples/）
LOCAL_BASE_DIR=./fengche/data_samples

# FTP 模式（仅当 DATA_SOURCE=ftp 时）
FTP_HOST=10.127.13.197
FTP_PORT=2123
FTP_USER=fengche
FTP_PASSWORD=
FTP_BASE_DIR=/

# 通用
DEFAULT_TIMEZONE=Asia/Shanghai
MAX_LOOKBACK_HOURS=24

# 路径模板（占位符 {Y} {Ym} {ymd} {HH}）
# local 默认: {ymd}/{ymd}T{HH}.nc
# ftp   默认: {Y}/{Ym}/{ymd}/{ymd}T{HH}.nc
# PATH_TEMPLATE={Y}/{Ym}/{ymd}/{ymd}T{HH}.nc

# === 阵风（强对流）阈值（m/s）===
GS_YELLOW_MS=17.2
GS_ORANGE_MS=24.5
GS_RED_MS=32.7

# === 暴雨阈值（mm，按 1h / 6h / 24h 三窗口 OR 触发）===
# 蓝色：仅 6h ≥ 50
# 黄色：1h ≥ 50 或 6h ≥ 100 或 24h ≥ 150
# 橙色：1h ≥ 75 或 6h ≥ 150 或 24h ≥ 200
# 红色：1h ≥ 100 或 6h ≥ 200 或 24h ≥ 250
RAIN_1H_YELLOW=50
RAIN_1H_ORANGE=75
RAIN_1H_RED=100
RAIN_6H_BLUE=50
RAIN_6H_YELLOW=100
RAIN_6H_ORANGE=150
RAIN_6H_RED=200
RAIN_24H_YELLOW=150
RAIN_24H_ORANGE=200
RAIN_24H_RED=250

# === 服务监听 ===
HOST=0.0.0.0
PORT=8766
