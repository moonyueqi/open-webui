# ===============================================================
# radar-push 服务环境变量。复制为 .env 后填写，.env 不要提交 git。
#   cp .env.example .env
# ===============================================================

# ----------------------------- 数据源（SFTP） ---------------------------
DATA_SOURCE=sftp
SFTP_HOST=10.127.13.190
SFTP_PORT=22
SFTP_USER=root
SFTP_PASSWORD=SzQXj@190#
# 数据根目录，Z / Et / TreRef 在 {base}/{YYYYMMDD}/Z|Et|TreRef/ 下
# 实况反射率与画图改用 Z（多层，取 2000m 高度层）；Et / TreRef 仍沿用原产品。
# 注意：同一时刻必须 Z + Et + TreRef 三者齐全才会推送；
#   缺 Et（顶高）或缺 TreRef（外推）时本轮跳过、不推进时间戳，待数据落盘后重试。
SFTP_NC_BASE_DIR=/space/duogee/data/runenv/product_data/Nc

# ----------------------------- 企业微信推送 ---------------------------
# 群机器人 webhook 完整地址（含 key）
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=585baafc-c117-41c6-9217-ea71b48a5b2d

# ----------------------------- 结果上传 FTP（可选） ---------------------------
# 把每次推送的结果（雷达图 PNG + 文案 TXT）另存一份上传到 FTP 目录。
# 与企业微信推送解耦：上传失败只记日志、绝不影响推送主流程。
# 文件名按观测时间命名平铺：radar_YYYYMMDD_HHMM.png / radar_YYYYMMDD_HHMM.txt
FTP_UPLOAD_ENABLED=true
FTP_HOST=180.100.210.61
FTP_PORT=2121
FTP_USER=hxkj
FTP_PASSWORD=hxkj@WSX2026
# 远程目标目录（相对登录后的根目录，自动逐级创建）
FTP_REMOTE_DIR=data/image/radar
# 被动模式：多数防火墙/NAT 环境需要开启（true）
FTP_PASSIVE=true
# 连接/传输超时（秒）
FTP_TIMEOUT_SEC=30
# 控制连接编码，中文路径/文件名建议 utf-8
FTP_ENCODING=utf-8
# 是否使用 FTPS（显式 TLS）。普通 FTP 保持 false
FTP_TLS=false

# ----------------------------- 风掣 AI 降水预报（可选） ---------------------------
# 启用后：每次推送都会附带「风掣预报」行——基于风掣 AI 的 1 小时降水预报，
#   按「逐小时为界」选目标时段，统计苏州各区县小时雨强范围（雨量从大到小排列，
#   无降水的区县不提及，全市无降水则报「以无明显降水为主」）。
#   与雷达推送解耦：找不到文件/超时/解析失败只记日志，绝不影响主流程。
FENGCHE_ENABLED=false
# 数据源类型：local（部署服务器本地目录，现行方式）或 ftp（旧的独立 FTP 服务器）。
FENGCHE_SOURCE=local
# local 模式根目录，按 path_template 的 {Y}/{Ym}/{ymd}/ 分层，
#   实际路径如 /bigdata/fengche-suzhou/2026/202606/20260626/20260626T08.nc
FENGCHE_LOCAL_BASE_DIR=/bigdata/fengche-suzhou
# ↓↓↓ 以下 FTP 参数仅 FENGCHE_SOURCE=ftp 时使用（local 模式可忽略）↓↓↓
# 风掣数据 FTP（与雷达 SFTP 是不同服务器）
FENGCHE_FTP_HOST=10.127.13.197
FENGCHE_FTP_PORT=2123
FENGCHE_FTP_USER=fengche
FENGCHE_FTP_PASSWORD=
# fengche 账号登录后看到的根目录即数据根，一般填 /
FENGCHE_FTP_BASE_DIR=/
# 路径模板，占位符 {Y} {Ym} {ymd} {HH}；FTP 默认分层布局：2026/202606/20260625/20260625T09.nc
FENGCHE_PATH_TEMPLATE={Y}/{Ym}/{ymd}/{ymd}T{HH}.nc
# 起报回退上限（小时）：从能覆盖目标时段的整点起逐小时回退查首个就绪文件
FENGCHE_MAX_LOOKBACK_HOURS=24
FENGCHE_FTP_TIMEOUT_SEC=30
FENGCHE_FTP_ENCODING=utf-8
# 「逐小时为界」分界分钟：观测分钟 <= 该值报当前小时段，> 该值报下一小时段。
#   例（默认 30）：9:30 及之前报 9-10 时；9:30 之后报 10-11 时。
FENGCHE_BOUNDARY_MINUTE=30
# 风掣等待超时（分钟）：决定推送时若风掣文件尚未就绪，则该时次「不推、下一轮重试」
#   （与外推 TreRef / 顶高 Et 的"待落盘"等待机制一致），直到距观测时刻超过此分钟数
#   仍未就绪才放弃；放弃后风掣行整行省略、不显示（不再用占位符兜底）。
#   设 0 表示不等待（找不到即放弃、行省略）。历史回放脚本会自动置 0 以免卡死。
FENGCHE_WAIT_MINUTES=15

# ----------------------------- 地面站点实况提醒（可选） ---------------------------
# 启用后：每次推送附带「实况提醒」行——按观测时刻对齐出实况窗口（如观测 14:36 → 窗口
#   13:30-14:30），从该时刻的全省站点快照里取苏州市内/上游侧的最大小时雨强与最大阵风。
#   仅当候选范围内出现「小时雨强>=阈值 或 阵风>=风级阈值」才输出本行，否则整行不显示。
#   与雷达推送解耦：找不到文件/解析失败只记日志、不影响主流程。
OBS_ENABLED=false
# 数据源：实况数据在部署服务器本地（非 FTP），用 local。
OBS_SOURCE=local
# 实况根目录。生产示例 /bigdata/data/aws/raw，目录按 UTC 年/月/日 分层。
OBS_LOCAL_BASE_DIR=/bigdata/data/aws/raw
# 路径模板，占位符基于 UTC 时刻：{Y} {m} {d} {Ym} {ymd} {HH} {MM} {ymdHM}
#   生产：{Y}/{m}/{d}/SURF_GUST1MIN_{ymdHM}.xlsx
#     -> /bigdata/data/aws/raw/2026/06/26/SURF_GUST1MIN_202606260030.xlsx
#   本地平铺样例：OBS_LOCAL_BASE_DIR=./data_samples/raw 且 OBS_PATH_TEMPLATE=SURF_GUST1MIN_{ymdHM}.xlsx
#   文件名时间为 UTC，「小时降水量」记录该时刻过去 1 小时累计雨量。
OBS_PATH_TEMPLATE={Y}/{m}/{d}/SURF_GUST1MIN_{ymdHM}.xlsx
# 窗口结束对齐：true=向下对齐到 :00/:30（半点边界，默认）；false=对齐到整点
OBS_HALF_HOUR_BOUNDARY=true
# 实况逐文件间隔（分钟）与回退查找上限（分钟）
OBS_STEP_MINUTES=10
OBS_MAX_LOOKBACK_MINUTES=60
# 阵风用列关键字（覆盖默认优先级）；留空则默认「最大阵风风速」优先
OBS_GUST_COLUMN=
# 触发「实况提醒」行的门槛：小时雨强(mm) 或 阵风风级（蒲福，7 级≈13.9m/s）
OBS_RAIN_THRESHOLD_MM=20
OBS_GUST_THRESHOLD_LEVEL=7
# 上游侧判定半张角（度）：市外站点相对市质心方位与回波「来向」夹角 <= 此值才算上游侧
OBS_UPSTREAM_HALF_ANGLE_DEG=90

# ----------------------------- 运行参数 ---------------------------
DEFAULT_TIMEZONE=Asia/Shanghai
SCAN_INTERVAL_SEC=60
# 外推未来帧数（6min/帧；未来 1h = 10 帧）
FUTURE_FRAMES=10
# 实况反射率取 Z 文件 data 的层索引（写死）：3 = 2000m
# data 维度 (layerNum, lat, lon)，layerNum=[0.5,1.0,1.5,2.0,...]km，故 2000m 对应索引 3
Z_LAYER_INDEX=3

# ----------------------------- 判定阈值（一般不用改） ---------------------------
STRONG_DBZ=35
# 回波顶高阈值（km）：Z(2000m)>=STRONG_DBZ 且 顶高>=ET_MIN_KM 的格点才算强回波（同时满足才推送）
ET_MIN_KM=7
# 实况最小连片格点数（四连通）：所有实况判断（缓冲区检测/区县/乡镇/上游/缓冲区）
#   都要求达标格点四连通连片 >= 此值才算数，用于抗噪、避免单个孤立格点误报。
#   注：预报（外推）刻意用宽松的单格点口径，不受此值约束。
MIN_CLUSTER_POINTS=4
LEVEL_STEP_DBZ=5
REDALERT_DBZ=45
BUFFER_KM=50
# 全局推送节流窗口（分钟）：该时间内最多推送 1 次，避免大范围过程刷屏。
#   窗口内即使有新区县达标/强度升档/达红色级别也一律不推，满窗后才能再推。设 0 关闭节流。
PUSH_WINDOW_MIN=12
# 距市界推送里程碑（km），逗号分隔，0 表示进入市内
BOUNDARY_KM_MILESTONES=25,10,5,0
# 规则7「全市大部分乡镇」覆盖阈值：单个区县受影响乡镇(街道)数占该区总数的比例 >= 此值，
#   即视为该区已"大部分乡镇受影响"；当全市每个受影响区县都达标后进入"全覆盖态"，
#   此后仅当全局回波强度等级再上升才推、范围继续扩大不再推。建议与文案折叠阈值一致(0.7)。
FULL_COVERAGE_RATIO=0.7

# 对流类型分级阈值（用于【预报】文字里的天气现象判别）：
#   下方 *_CR_* 变量名为历史沿用（实为 Z 2000m 反射率阈值，已不再读 CR/组合反射率）。
#   判别取值 = 实况市内 Z 稳健值（市外取主威胁团 Z 稳健值）+ 苏州市内 ET 最大值
#   Z 35~45            -> 短时强降水
#   Z>=45 且 ET 7~9    -> 短时强降水
#   Z>=GALE_CR 且 ET>=GALE_ET -> 增加 雷暴大风
#   Z>=HAIL_CR 且 ET>=HAIL_ET -> 再增加 局地小冰雹
GALE_CR_DBZ=45
GALE_ET_KM=9
HAIL_CR_DBZ=55
HAIL_ET_KM=12

# ----------------------------- 缺测值（一般不用改） ---------------------------
NC_NO_COVER=-32768
NC_NO_ECHO=-128

# ----------------------------- 大模型文案润色（可选） ---------------------------
# 数据由算法定死，模型仅润色措辞；输出经严格校验，失败/异常自动回退模板，零风险。
# 默认关闭（不配置即纯模板）。开启需填 LLM_API_KEY。OpenAI 兼容接口（此处为阿里云百炼）。
LLM_POLISH_ENABLED=true
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-6a1d1a38dec94d7591108e19c9621351
LLM_MODEL=qwen3.7-plus
# 请求超时（秒）：超时即回退模板，不阻塞推送。云端模型首字延迟较大，建议 >=30
LLM_TIMEOUT_SEC=30
# 采样温度：低温度减少模型自由发挥
LLM_TEMPERATURE=0.2
# 是否开启"深度思考"。qwen3 等混合推理模型默认思考会先吐长思考再出正文，延迟极大；
# 文案润色无需推理，建议保持 false（关闭思考）以显著降低延迟。
LLM_ENABLE_THINKING=false
